{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamessawle/sbxflow/blob/main/schema/sbxflow.schema.json",
  "title": "sbxflow configuration",
  "description": "A version 1 Docker Sandbox declaration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sandbox"],
  "properties": {
    "version": {
      "const": 1,
      "description": "The sbxflow configuration format version."
    },
    "sandbox": { "$ref": "#/$defs/sandbox" }
  },
  "$defs": {
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "agent", "kits"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "agent": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "copilot",
            "cursor",
            "docker-agent",
            "droid",
            "gemini",
            "kiro",
            "opencode",
            "shell"
          ]
        },
        "kits": { "$ref": "#/$defs/kits" },
        "workspace": { "$ref": "#/$defs/workspace" },
        "network": { "$ref": "#/$defs/network" },
        "hooks": { "$ref": "#/$defs/hooks" }
      }
    },
    "workspace": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["direct", "clone"] }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialize": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A host, domain, wildcard subdomain, bracketed IPv6 literal, or \"**\", each with an optional :port suffix from 1 to 65535. Docker Sandboxes matches network requests by host and port, so a URL is not a usable resource. A pattern cannot express IPv6 semantics, so sbxflow additionally parses the bracketed form and rejects a malformed address.",
            "pattern": "^(\\*\\*|(\\*\\.)?([A-Za-z0-9_-]+\\.)*[A-Za-z0-9_-]+|\\[[0-9A-Fa-f:.]+\\])(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
          }
        }
      }
    },
    "kits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "use"],
      "properties": {
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/source" }
        },
        "use": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/selection" }
        }
      }
    },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/gitSource" },
        { "$ref": "#/$defs/ociSource" },
        { "$ref": "#/$defs/localSource" }
      ]
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo", "ref"],
      "properties": {
        "type": { "const": "git" },
        "repo": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "ociSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "base"],
      "properties": {
        "type": { "const": "oci" },
        "base": { "type": "string", "minLength": 1 }
      }
    },
    "localSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "root"],
      "properties": {
        "type": { "const": "local" },
        "root": { "type": "string", "minLength": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "kit"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "kit": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
